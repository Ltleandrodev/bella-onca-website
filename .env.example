# Supabase Configuration
# URL do projeto disponível em:
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon / publishable key)
# Disponível nas configurações de API do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Chave administrativa privada
# NUNCA utilize esta chave no frontend ou publique uma chave real!
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Email do administrador do sistema
ADMIN_EMAIL=admin@exemplo.com